VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://api.captaindev.ir
VITE_PRODUCTS_ROUTE=/product
VITE_CATEGORIES_ROUTE=/category
VITE_BASKET_ROUTE=/basket

# Current-user endpoint must return the authenticated user and role(s).
VITE_ME_ROUTE=/users/me
VITE_PROFILE_ROUTE=/profile
VITE_PROFILE_UPDATE_ROUTE=/profile
VITE_ORDERS_ALL_ROUTE=/order/all
VITE_ORDER_ROUTE=/order
VITE_ORDER_SET_ROUTE=/order/set
# Default requested route. Backend must separate category lookup from product lookup.
VITE_PRODUCTS_BY_CATEGORY_ROUTE=/product/get/:categoryId

# Enable only after the corresponding backend endpoints exist (see BACKEND_INTEGRATION.md).
VITE_PRODUCT_UPDATE_ROUTE=
VITE_PRODUCT_DELETE_ROUTE=
VITE_SUPPORT_LIST_ROUTE=
VITE_SUPPORT_CREATE_ROUTE=
VITE_SUPPORT_UPDATE_ROUTE=
VITE_SUPPORT_DELETE_ROUTE=
VITE_SITES_LIST_ROUTE=
